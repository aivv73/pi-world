{
	"name": "@aivv/pi-world",
	"version": "0.4.0",
	"type": "module",
	"description": "An experimental pi extension with a single tool: execute, running TypeScript in a persistent Bun evaluator",
	"keywords": [
		"pi-package",
		"pi",
		"agent",
		"bun",
		"typescript",
		"repl"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aivv73/pi-world.git"
	},
	"homepage": "https://github.com/aivv73/pi-world#readme",
	"bugs": {
		"url": "https://github.com/aivv73/pi-world/issues"
	},
	"pi": {
		"extensions": [
			"./src/extension/index.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"ARCHITECTURE.md",
		"docs",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"test": "bun test test/",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"check": "bun run typecheck && bun run lint && bun test test/"
	},
	"dependencies": {
		"@howaboua/pi-codex-conversion": "3.0.14",
		"acorn": "^8.18.0",
		"effect": "4.0.0-rc.108"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@types/bun": "^1.3.14",
		"typebox": "^1.3.11",
		"typescript": "^7.0.2"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	}
}
