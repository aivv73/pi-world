{
	"name": "pi-rlm",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "RLM engine for pi: one `ts` tool executing TypeScript in a persistent Bun evaluator",
	"pi": {
		"extensions": [
			"./src/extension/index.ts"
		]
	},
	"scripts": {
		"test": "bun test test/",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"check": "bun run typecheck && bun run lint && bun test test/"
	},
	"dependencies": {
		"acorn": "^8.18.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@types/bun": "^1.3.14",
		"typebox": "^1.3.11",
		"typescript": "^7.0.2"
	}
}
